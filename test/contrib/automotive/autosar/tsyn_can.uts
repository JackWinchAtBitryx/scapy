% Regression tests for AUTOSAR Time Synchronization over CAN


# More information at http://www.secdev.org/projects/UTscapy/


############
############

+ AUTOSAR Time Synchronization over CAN tests

= Load Contrib Layer

load_contrib("automotive.autosar.tsyn_can", globals_dict=globals())

= Base layer defaults test

p = Base()
assert p.type == 0x10

= SYNC message defaults test

p = Sync()
assert p.user_byte_1 == 0
assert p.time_domain == 0
assert p.seq_counter == 0
assert p.user_byte_0 == 0
assert p.sync_time_sec == 0

= FollowUp message defaults test

p = FollowUp()
assert p.user_byte_2 == 0
assert p.time_domain == 0
assert p.seq_counter == 0
assert p.reserved == 0
assert p.sgw == 0
assert p.ovs == 0
assert p.sync_time_nsec == 0

= Build and parse SYNC message (Type 0x10)

# Build SYNC message
pkt_build = Base(type=0x10) / Sync(
    user_byte_1=0,
    time_domain=1,
    seq_counter=5,
    user_byte_0=0,
    sync_time_sec=1234567890
)

# Convert to bytes
raw = bytes(pkt_build)
assert len(raw) == 8
assert raw == b'\x10\x00\x15\x00\x49\x96\x02\xd2'

# Parse back
pkt_parsed = Base(raw)
assert pkt_parsed.type == 0x10
assert pkt_parsed.haslayer(Sync)
assert pkt_parsed[Sync].time_domain == 1
assert pkt_parsed[Sync].seq_counter == 5
assert pkt_parsed[Sync].sync_time_sec == 1234567890

= Build and parse FUP message (Type 0x18)

# Build FUP message
pkt_build = Base(type=0x18) / FollowUp(
    user_byte_2=0,
    time_domain=2,
    seq_counter=10,
    reserved=0,
    sgw=1,
    ovs=2,
    sync_time_nsec=987654321
)

# Convert to bytes
raw = bytes(pkt_build)
assert len(raw) == 8
assert raw[0] == 0x18

# Parse back
pkt_parsed = Base(raw)
assert pkt_parsed.type == 0x18
assert pkt_parsed.haslayer(FollowUp)
assert pkt_parsed[FollowUp].time_domain == 2
assert pkt_parsed[FollowUp].seq_counter == 10
assert pkt_parsed[FollowUp].sgw == 1
assert pkt_parsed[FollowUp].ovs == 2
assert pkt_parsed[FollowUp].sync_time_nsec == 987654321

= Build and parse SYNC CRC message (Type 0x20)

# Build SYNC CRC message
pkt_build = Base(type=0x20) / SyncWithCrc(
    crc=0xAB,
    time_domain=3,
    seq_counter=7,
    user_byte_0=0x00,
    sync_time_sec=1111111111
)

# Convert to bytes
raw = bytes(pkt_build)
assert len(raw) == 8
assert raw[0] == 0x20
assert raw[1] == 0xAB

# Parse back
pkt_parsed = Base(raw)
assert pkt_parsed.type == 0x20
assert pkt_parsed.haslayer(SyncWithCrc)
assert pkt_parsed[SyncWithCrc].crc == 0xAB
assert pkt_parsed[SyncWithCrc].time_domain == 3
assert pkt_parsed[SyncWithCrc].seq_counter == 7
assert pkt_parsed[SyncWithCrc].sync_time_sec == 1111111111

= Build and parse FUP CRC message (Type 0x28)

# Build FUP CRC message
pkt_build = Base(type=0x28) / FollowUpWithCrc(
    crc=0xCD,
    time_domain=4,
    seq_counter=8,
    reserved=0,
    sgw=0,
    ovs=1,
    sync_time_nsec=123456789
)

# Convert to bytes
raw = bytes(pkt_build)
assert len(raw) == 8
assert raw[0] == 0x28
assert raw[1] == 0xCD

# Parse back
pkt_parsed = Base(raw)
assert pkt_parsed.type == 0x28
assert pkt_parsed.haslayer(FollowUpWithCrc)
assert pkt_parsed[FollowUpWithCrc].crc == 0xCD
assert pkt_parsed[FollowUpWithCrc].time_domain == 4
assert pkt_parsed[FollowUpWithCrc].seq_counter == 8
assert pkt_parsed[FollowUpWithCrc].sync_time_nsec == 123456789

= Build and parse OFS message (Type 0x34)

# Build OFS message
# Note: time_domain field stores 0-15, interpreted as domain IDs 16-31
pkt_build = Base(type=0x34) / Offset(
    user_byte_1=0,
    time_domain=4,  # Represents domain ID 20 (16 + 4)
    seq_counter=5,
    user_byte_0=0,
    ofs_time_sec=2222222222
)

# Convert to bytes
raw = bytes(pkt_build)
assert len(raw) == 8
assert raw[0] == 0x34

# Parse back
pkt_parsed = Base(raw)
assert pkt_parsed.type == 0x34
assert pkt_parsed.haslayer(Offset)
assert pkt_parsed[Offset].time_domain == 4
assert pkt_parsed[Offset].seq_counter == 5
assert pkt_parsed[Offset].ofs_time_sec == 2222222222

= Build and parse OFNS message (Type 0x3C)

# Build OFNS message
pkt_build = Base(type=0x3C) / OffsetNanoseconds(
    user_byte_2=0,
    time_domain=9,  # Represents domain ID 25 (16 + 9)
    seq_counter=6,
    reserved=0,
    sgw=1,
    ofs_time_nsec=555555555
)

# Convert to bytes
raw = bytes(pkt_build)
assert len(raw) == 8
assert raw[0] == 0x3C

# Parse back
pkt_parsed = Base(raw)
assert pkt_parsed.type == 0x3C
assert pkt_parsed.haslayer(OffsetNanoseconds)
assert pkt_parsed[OffsetNanoseconds].time_domain == 9
assert pkt_parsed[OffsetNanoseconds].seq_counter == 6
assert pkt_parsed[OffsetNanoseconds].sgw == 1
assert pkt_parsed[OffsetNanoseconds].ofs_time_nsec == 555555555

